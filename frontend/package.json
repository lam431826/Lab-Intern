{
  "name": "dxlab-recruitment-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "gen:api": "npx -y openapi-typescript@7.13.0 http://localhost:8080/v3/api-docs -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@clerk/react": "6.18.9",
    "@clerk/ui": "1.43.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "msw": "3.0.6",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
