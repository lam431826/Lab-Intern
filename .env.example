# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Backend tự đọc file này khi chạy (spring.config.import), không cần export biến.

# ---------- SQL Server ----------
DB_HOST=localhost
DB_PORT=1433
DB_NAME=dxlab_recruitment
DB_USER=dxlab_app
DB_PASSWORD=
# true khi SQL Server dùng chứng chỉ tự ký (máy dev, container)
DB_TRUST_CERT=true

# Chỉ dùng khi chạy bằng docker compose (docs/runbook.md): mật khẩu SA của container SQL Server.
# Ít nhất 8 ký tự gồm chữ hoa, chữ thường và số; chỉ dùng chữ và số
MSSQL_SA_PASSWORD=
# Express (mặc định, miễn phí) | Developer (chỉ dev/test)
MSSQL_PID=Express
APP_PORT=8080

# ---------- Clerk (Dashboard -> Configure -> API keys) ----------
# Frontend API URL, ví dụ https://<slug>.clerk.accounts.dev
CLERK_ISSUER=
# Origin của frontend, nhiều giá trị cách nhau bởi dấu phẩy
CLERK_AZP=http://localhost:5173
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=

# ---------- Ứng dụng ----------
APP_CORS_ORIGINS=http://localhost:5173
# Trang người được mời mở ra sau khi bấm link trong email Clerk
APP_FRONTEND_URL=http://localhost:5173
SPRING_PROFILES_ACTIVE=local
# Email bạn dùng đăng nhập Clerk ở máy dev; được tạo sẵn tài khoản Người tổ chức (chỉ profile local)
DEV_ADMIN_EMAIL=
# Máy chủ mới: email Người tổ chức đầu tiên, được tạo lúc khởi động nếu chưa có Người tổ chức nào
BOOTSTRAP_ORGANIZER_EMAIL=
