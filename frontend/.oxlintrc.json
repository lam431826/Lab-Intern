{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist",
    "src/api/schema.d.ts"
  ],
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "react/only-export-components": "off",
        "no-shadow": "off"
      }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "@testing-library/jest-dom/vitest"
        ]
      }
    ],
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__APP_CONFIG__"
        ]
      }
    ]
  }
}
