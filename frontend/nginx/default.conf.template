# Sinh ra /etc/nginx/conf.d/default.conf lúc container khởi động (envsubst của image nginx).
# Biến: BACKEND_URL (http://app:8080), CLERK_FRONTEND_API (giống CLERK_ISSUER của backend).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Khớp giới hạn upload của backend (5 MB/file, 6 MB/request): file JD, Excel hồ sơ
    client_max_body_size 6m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API và health đi qua cùng origin: trình duyệt không cần CORS
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    location = /actuator/health {
        proxy_pass ${BACKEND_URL};
    }

    # File build có hash trong tên: cache lâu
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri =404;
    }

    # Cấu hình lúc chạy (40-app-config.sh ghi): không cache để đổi khóa Clerk có hiệu lực ngay
    location = /config.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Mọi route của SPA (/candidates/7, /scoring/...) trả index.html
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri $uri/ /index.html;
    }
}
